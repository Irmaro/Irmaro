---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

type PageKey =
  | 'home'
  | 'about'
  | 'offer'
  | 'booking'
  | 'perspectives'
  | 'contact'
  | 'privacy'
  | 'terms';

interface Props {
  title: string;
  description?: string;
  lang: 'en' | 'pl';
  pageKey: PageKey;
  schema?: Record<string, unknown>;
}

const {
  title,
  description = 'IRMARO — Life & Career Coach & Mentor',
  lang,
  pageKey,
  schema,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <!-- Browser tab icon: use the IRMARO logo directly. -->
    <link rel="icon" type="image/png" href="/images/irmaro-logo.png?v=3" />
    <link rel="shortcut icon" type="image/png" href="/images/irmaro-logo.png?v=3" />
    <link rel="apple-touch-icon" href="/images/irmaro-logo.png?v=3" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <title>{title}</title>

    {schema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
      />
    )}
  </head>

  <body>
    <Header lang={lang} pageKey={pageKey} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
