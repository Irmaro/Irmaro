---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

type PageKey =
  | 'home'
  | 'about'
  | 'offer'
  | 'booking'
  | 'perspectives'
  | 'contact'
  | 'privacy'
  | 'terms';

interface Props {
  title: string;
  description?: string;
  lang: 'en' | 'pl';
  pageKey: PageKey;
  schema?: Record<string, unknown>;
  alternateHref?: string;
}

const {
  title,
  description = 'IRMARO — Life & Career Coach · Mentor',
  lang,
  pageKey,
  schema,
  alternateHref,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <!-- IRMARO tree mark used as browser-tab icon. -->
    <link rel="icon" type="image/png" href="/images/logo_tree_no_bg.png?v=1" />
    <link rel="shortcut icon" type="image/png" href="/images/logo_tree_no_bg.png?v=1" />
    <link rel="apple-touch-icon" href="/images/logo_tree_no_bg.png?v=1" />

<meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <title>{title}</title>

    {schema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
      />
    )}
  </head>

  <body>
    <Header lang={lang} pageKey={pageKey} alternateHref={alternateHref} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
