---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<BaseLayout
  title="Kontakt | IRMARO"
  description="Kontakt z IRMARO."
  lang="pl"
  pageKey="contact"
>
  <section class="page-hero contact-intro">
    <div class="container">
      <p class="eyebrow">KONTAKT</p>
      <h1>Porozmawiajmy.</h1>
      <p class="lead">
        Zapytaj o indywidualny proces coachingowy albo zostaw dane kontaktowe i napisz krótko, czego dotyczy Twój temat.
      </p>
    </div>
  </section>

  <section class="section contact-section">
    <div class="container">
      <ContactForm lang="pl" />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-intro {
    padding-bottom: 34px;
  }

  .contact-section {
    padding-top: 28px;
  }
</style>
