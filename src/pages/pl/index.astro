---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="IRMARO | Life & Career Coach & Mentor"
  description="IRMARO — Life & Career Coach & Mentor."
  lang="pl"
  pageKey="home"
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Life & Career Coach & Mentor</p>
      <h1>Zmiana zaczyna się tutaj.</h1>
      <p class="lead">
        Spokojna przestrzeń do refleksji, decyzji i świadomej zmiany — w życiu i karierze.
      </p>

      <div class="actions">
        <a class="button primary" href="/pl/umow-sesje/">Umów sesję</a>
        <a class="button" href="/pl/o-mnie/">O mnie</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">ZOBACZ</p>
        <h2>Zacznij od tego, czego teraz potrzebujesz.</h2>
      </div>

      <div class="link-grid">
        <a class="link-card" href="/pl/oferta/">
          <div>
            <p class="eyebrow">01</p>
            <h3>Oferta</h3>
            <p>Możliwe formy współpracy.</p>
          </div>
          <span class="arrow">→</span>
        </a>

        <a class="link-card" href="/pl/umow-sesje/">
          <div>
            <p class="eyebrow">02</p>
            <h3>Umów sesję</h3>
            <p>Wybierz formę spotkania dopasowaną do sytuacji.</p>
          </div>
          <span class="arrow">→</span>
        </a>

        <a class="link-card" href="/pl/perspektywy/">
          <div>
            <p class="eyebrow">03</p>
            <h3>Perspektywy</h3>
            <p>Refleksje o zmianie, pracy, decyzjach i rozwoju.</p>
          </div>
          <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
