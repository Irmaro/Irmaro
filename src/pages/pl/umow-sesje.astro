---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingOptions from '../../components/BookingOptions.astro';
---

<BaseLayout
  title="Umów sesję | Coaching i mentoring | IRMARO"
  description="Rozmowa wstępna, sesje coachingowe i mentoringowe, pakiety, analiza CV i LinkedIn oraz przygotowanie do interview."
  lang="pl"
  pageKey="booking"
>
  <section class="page-hero booking-hero">
    <div class="container narrow-copy">
      <p class="eyebrow">UMÓW SESJĘ</p>
      <h1><strong><em>Wybierz formę wsparcia odpowiednią dla siebie</em></strong></h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <BookingOptions lang="pl" />
    </div>
  </section>
</BaseLayout>


<style>
  .booking-hero {
    padding-top: 26px;
    padding-bottom: 18px;
  }

  .booking-hero .eyebrow {
    margin-bottom: 8px;
  }

  .booking-hero h1 {
    margin-bottom: 0;
    line-height: 1.02;
  }

  @media (max-width: 700px) {
    .booking-hero {
      padding-top: 18px;
      padding-bottom: 14px;
    }

    .booking-hero .eyebrow {
      margin-bottom: 6px;
    }
  }
</style>
