---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GoldenThought from '../../components/GoldenThought.astro';
import Testimonials from '../../components/Testimonials.astro';
import AboutPortrait from '../../components/AboutPortrait.astro';
import LinkedInBanner from '../../components/LinkedInBanner.astro';
import { site } from '../../config/site';
---

<BaseLayout
  title="About Irma Rosenvik | Coach, Mentor & HR Professional"
  description="Meet Irma Rosenvik, a certified coach, mentor and HR professional based in Finland."
  lang="en"
  pageKey="about"
>
  <section class="page-hero">
    <div class="container narrow-copy">
      <p class="eyebrow">ABOUT</p>
      <h1>
        <strong>
          <em>
            I know what change feels like — and I know how much good can unfold along the way.
          </em>
        </strong>
      </h1>
    </div>
  </section>

  <section class="section">
    <div class="container about-layout">

      <div class="source-copy about-intro-copy">
        <p>
          <em>
            My name is Irma and I am a certified coach. I completed my coach training at
            Meritum Coaching School through a programme accredited by the International
            Coaching Federation (ICF). I also work as an HR professional.
          </em>
        </p>

        <p>
          <em>
            These two parts of my professional life naturally belong together because, for
            me, the person always comes first — their story, needs, values, emotions and
            their right to build a life that feels true to who they are. I believe there is
            far more potential in us than we sometimes recognise. At certain moments, what
            we need most is a safe space, an attentive conversation and another person who
            can help us see what is already there.
          </em>
        </p>

        <div class="green-panel editorial-panel">
          <p>
            <em>
              My own path has been long, searching and, at times, very uneven. I grew up in
              a state of constant alertness and later came to understand my experience as an
              Adult Child of an Alcoholic (ACoA). I built my own family, raised my son —
              including what I jokingly call the most demanding extreme sport of all:
              parenting a teenager — and went through both individual and family therapy.
            </em>
          </p>
        </div>

        <p>
          <em>
            There was also emigration: learning to live in a new reality and rebuilding my
            career from the ground up in another country. There were moments of doubt,
            exhaustion and having to begin again. There was sweat, there were tears and
            there was depression. But there was also strength, rediscovering myself,
            learning to treat myself with more kindness and finding a deeper sense of inner
            balance.
          </em>
        </p>

        <p>
          <em>
            Today I know how to celebrate life — not because it is perfect, but because I
            know how much can happen along the way. That is one of the reasons I genuinely
            love change.
          </em>
        </p>
      </div>

      <div class="about-photo">
        <AboutPortrait lang="en" />
      </div>

      <div class="source-copy about-rest">
        <div class="green-panel editorial-panel">
          <p>
            <em>
              This is the perspective I bring to my work with clients. No judgement. No
              ready-made answers. Just curiosity, attention and a deep belief that you are
              the expert on your own life.
            </em>
          </p>
        </div>

        <GoldenThought
          text="Some things need time before their meaning can truly settle."
          tone="beige"
        />

        <p>
          <em>
            If you would like to know me beyond my professional role, visit
            <strong><a href="/en/perspectives/">Perspectives</a></strong>, where I share
            more about how I see life and the values that guide me.
          </em>
        </p>

        <p>
          <em>
            If you would like to learn more about my professional background, you are also
            welcome to visit my
            <strong>
              <a
                href={site.linkedInUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                LinkedIn profile
              </a>
            </strong>.
          </em>
        </p>

        <LinkedInBanner lang="en" />

        <Testimonials lang="en" />
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  /*
    One grid controls the entire About section.

    Desktop:
    intro text | photo
    rest       | empty

    This guarantees that the lower content starts exactly
    on the same vertical line as the text above.
  */
  .about-layout {
    --about-photo-width: 290px;
    --about-gap: clamp(28px, 3vw, 44px);

    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--about-photo-width);
    grid-template-areas:
      "intro photo"
      "rest  .";
    column-gap: var(--about-gap);
    row-gap: 34px;
    align-items: start;
  }

  .about-intro-copy {
    grid-area: intro;
    min-width: 0;

    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .about-photo {
    grid-area: photo;
    min-width: 0;
    align-self: start;
  }

  .about-rest {
    grid-area: rest;
    min-width: 0;

    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .about-intro-copy > p,
  .about-intro-copy > .green-panel,
  .about-rest > p,
  .about-rest > .green-panel {
    margin: 0;
  }

  .about-intro-copy .green-panel p,
  .about-rest .green-panel p {
    margin: 0;
  }

  /*
    The banner stays aligned to the left edge of the text column.
    Its own component controls the 75% width.
  */
  .about-rest :global(.linkedin-banner) {
    margin-left: 0;
    margin-right: auto;
  }

  /*
    Golden Thought should fill the text column instead of appearing
    as a separate centred block detached from the copy.
  */
  .about-rest :global(.golden-thought) {
    width: 100%;
    max-width: none;
    margin: 10px 0;
  }

  /*
    Testimonials remain separated from the About story.
  */
  .about-rest :global(.testimonials-section) {
    margin-top: 30px;
  }

  @media (max-width: 980px) {
    .about-layout {
      --about-photo-width: 250px;
      --about-gap: 30px;
    }
  }

  @media (max-width: 820px) {
    .about-layout {
      grid-template-columns: 1fr;
      grid-template-areas:
        "intro"
        "photo"
        "rest";
      gap: 28px;
    }

    .about-photo {
      justify-self: center;
      width: 100%;
    }

    .about-rest {
      gap: 24px;
    }
  }
</style>
