---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PerspectiveCard from '../../components/PerspectiveCard.astro';
import { perspectives } from '../../content/perspectives';
---
<BaseLayout title="Perspectives | IRMARO" description="Irma Rosenvik's reflections on coaching, relationships, change, self-awareness and the experiences that shape the way we see life." lang="en" pageKey="perspectives">
  <section class="page-hero perspectives-hero">
    <div class="container narrow-copy">
      <p class="eyebrow">PERSPECTIVES</p>
      <h1><strong>Thoughts worth pausing with for a moment.</strong></h1>
      <p class="lead">Reflections on change, relationships, coaching and everyday experiences that can begin to look different when we give ourselves enough space to examine them.</p>
    </div>
  </section>
  <section class="section perspectives-section">
    <div class="container perspectives-grid">
      {perspectives.en.map((article) => (<PerspectiveCard {...article} lang="en" />))}
    </div>
  </section>
</BaseLayout>
<style>
  .perspectives-hero .lead { max-width: 760px; color: var(--muted); font-size: 1.08rem; }
  .perspectives-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .perspectives-section { padding-top: 12px !important; }
  @media (max-width: 900px) { .perspectives-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .perspectives-grid { grid-template-columns: 1fr; } }
</style>
