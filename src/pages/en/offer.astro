---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Coaching & Mentoring | Oulu & Online | IRMARO"
  description="Coaching and mentoring with Irma Rosenvik — online and in person in Oulu."
  lang="en"
  pageKey="offer"
>
  <section class="page-hero">
    <div class="container narrow-copy">
      <p class="eyebrow">OFFER</p>
      <h1><strong>How can I support you?</strong></h1>
      <p class="lead">Two ways of working together, depending on what you need right now.</p>
    </div>
  </section>

  <section class="section offer-overview">
    <div class="container offer-product-grid">
      <article class="offer-product-card">
        <div>
          <h2>Coaching</h2>
          <p class="offer-product-opening">Choose coaching when you want to hear yourself more clearly.</p>
          <p>It can help when you need to untangle your thoughts, name your own direction and reach answers that genuinely belong to you.</p>
        </div>
        <div class="offer-product-actions">
          <a class="button" href="/en/offer/coaching/">Explore coaching</a>
          <a class="button offer-contact-button" href="/en/contact/#contact-form">Ask about a coaching session</a>
        </div>
      </article>

      <article class="offer-product-card">
        <div>
          <h2>Mentoring</h2>
          <p class="offer-product-opening">Choose mentoring when you also want a practical perspective.</p>
          <p>It may suit you when, alongside a thoughtful conversation, you want knowledge, lived experience and concrete guidance around career or life change.</p>
        </div>
        <div class="offer-product-actions">
          <a class="button" href="/en/offer/mentoring/">Explore mentoring</a>
          <a class="button offer-contact-button" href="/en/contact/#contact-form">Ask about a mentoring session</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero .lead { max-width: 680px; color: var(--muted); font-size: 1.08rem; }
  .offer-overview { padding-top: 24px !important; }
  .offer-product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .offer-product-card { display: flex; min-height: 370px; padding: clamp(26px, 4vw, 40px); flex-direction: column; justify-content: space-between; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .offer-product-card h2 { margin-bottom: 18px; }
  .offer-product-card p { line-height: 1.75; }
  .offer-product-opening { font-size: clamp(1.16rem, 2vw, 1.42rem); font-weight: 600; }
  .offer-product-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .offer-contact-button { border-color: var(--moss-dark) !important; }
  @media (max-width: 820px) { .offer-product-grid { grid-template-columns: 1fr; } .offer-product-card { min-height: 0; } }
</style>
