---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="IRMARO | Life & Career Coach & Mentor"
  description="IRMARO — Life & Career Coach & Mentor."
  lang="en"
  pageKey="home"
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Life & Career Coach & Mentor</p>
      <h1>Change begins here.</h1>
      <p class="lead">
        A calm space for reflection, decisions and meaningful change — in life and career.
      </p>

      <div class="actions">
        <a class="button primary" href="/en/book-a-session/">Book a session</a>
        <a class="button" href="/en/about/">About</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">EXPLORE</p>
        <h2>Start where it feels most useful.</h2>
      </div>

      <div class="link-grid">
        <a class="link-card" href="/en/offer/">
          <div>
            <p class="eyebrow">01</p>
            <h3>Offer</h3>
            <p>Ways we can work together.</p>
          </div>
          <span class="arrow">→</span>
        </a>

        <a class="link-card" href="/en/book-a-session/">
          <div>
            <p class="eyebrow">02</p>
            <h3>Book a session</h3>
            <p>Choose the format that fits your situation.</p>
          </div>
          <span class="arrow">→</span>
        </a>

        <a class="link-card" href="/en/perspectives/">
          <div>
            <p class="eyebrow">03</p>
            <h3>Perspectives</h3>
            <p>Reflections on change, work, decisions and development.</p>
          </div>
          <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
