---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<BaseLayout
  title="Contact | IRMARO"
  description="Contact IRMARO."
  lang="en"
  pageKey="contact"
>
  <section class="page-hero contact-intro">
    <div class="container">
      <p class="eyebrow">CONTACT</p>
      <h1><strong>Let’s talk.</strong></h1>
      <p class="lead">
        Leave your contact details and briefly tell me what your enquiry is about.
      </p>
    </div>
  </section>

  <section class="section contact-section">
    <div class="container">
      <ContactForm lang="en" />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-intro {
    padding-bottom: 34px;
  }

  .contact-section {
    padding-top: 28px;
  }
</style>
