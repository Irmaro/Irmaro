---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PerspectiveCard from '../../components/PerspectiveCard.astro';
import { perspectives } from '../../content/perspectives';
---

<BaseLayout
  title="Perspektywy | IRMARO"
  description="Refleksje Irmy Rosenvik o coachingu, relacjach, zmianie, miłości i tym, co pomaga lepiej rozumieć siebie oraz innych."
  lang="pl"
  pageKey="perspectives"
>
  <section class="page-hero perspectives-hero">
    <div class="container narrow-copy">
      <p class="eyebrow">PERSPEKTYWY</p>
      <h1><strong>Myśli, przy których warto zatrzymać się na chwilę.</strong></h1>
      <p class="lead">
        Refleksje o zmianie, relacjach, coachingu i codziennych doświadczeniach,
        które czasem zaczynają wyglądać inaczej, kiedy damy sobie przestrzeń, by im się przyjrzeć.
      </p>
    </div>
  </section>

  <section class="section perspectives-section">
    <div class="container perspectives-grid">
      {perspectives.pl.map((article) => (
        <PerspectiveCard {...article} lang="pl" />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .perspectives-hero .lead {
    max-width: 760px;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .perspectives-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .perspectives-section {
    padding-top: 12px !important;
  }

  @media (max-width: 900px) {
    .perspectives-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .perspectives-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
