---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingOptions from '../components/BookingOptions.astro';
---

<BaseLayout
  title="Pricing | Coaching, mentoring & career support | IRMARO"
  description="IRMARO pricing for coaching, mentoring, session packages and career support."
  lang="en"
  pageKey="booking"
>
  <section class="page-hero">
    <div class="container narrow-copy">
      <p class="eyebrow">PRICING</p>
      <h1><strong><em>Find the support that fits you best</em></strong></h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <BookingOptions lang="en" />
    </div>
  </section>
</BaseLayout>
