---
interface Props {
  lang: 'en' | 'pl';
}

const { lang } = Astro.props;
const isEn = lang === 'en';

const c = isEn
  ? {
      topic: 'Topic*',
      topicPlaceholder: 'Choose a topic',

      introCall: 'Free intro call',
      coachingSession: 'Single coaching session',
      mentoringSession: 'Single mentoring session',
      cvReview: 'CV and cover letter review',
      linkedinReview: 'LinkedIn profile review',
      interviewPreparation: 'Individual interview preparation',
      coachingPackage: 'Coaching package',
      mentoringPackage: 'Mentoring package',
      other: 'Other topic',

      name: 'Name*',
      email: 'Email*',
      phone: 'Phone (optional)',
      phonePlaceholder: '+358 40 000 0000',

      message: 'Your enquiry',
      messagePlaceholder:
        'Briefly tell me what your enquiry is about and what you would like support with.',

      privacy:
        'I will use your data only to respond to your enquiry. Please do not include health information or other special-category personal data in this form.',

      privacyLabel: 'Privacy Policy',
      privacyHref: '/en/privacy-policy/',

      submit: 'Send message',
      sending: 'Sending…',
      success: 'Thank you. Your message has been sent.',
      error: 'The message could not be sent. Please try again in a moment.',
    }
  : {
      topic: 'Temat*',
      topicPlaceholder: 'Wybierz temat',

      introCall: 'Bezpłatna rozmowa wstępna',
      coachingSession: 'Pojedyncza sesja coachingowa',
      mentoringSession: 'Pojedyncza sesja mentoringowa',
      cvReview: 'Analiza CV i listu motywacyjnego',
      linkedinReview: 'Analiza profilu na LinkedIn',
      interviewPreparation: 'Indywidualne przygotowanie do rozmowy kwalifikacyjnej',
      coachingPackage: 'Pakiet coachingowy',
      mentoringPackage: 'Pakiet mentoringowy',
      other: 'Inny temat',

      name: 'Imię*',
      email: 'E-mail*',
      phone: 'Telefon (opcjonalnie)',
      phonePlaceholder: '+48 500 000 000',

      message: 'Twoje zapytanie',
      messagePlaceholder:
        'Napisz krótko, czego dotyczy Twój temat i jakiego wsparcia potrzebujesz.',

      privacy:
        'Dane wykorzystam wyłącznie do odpowiedzi na Twoje zapytanie. Nie podawaj w formularzu danych o zdrowiu ani innych szczególnych kategorii danych.',

      privacyLabel: 'Polityka prywatności',
      privacyHref: '/pl/polityka-prywatnosci/',

      submit: 'Wyślij wiadomość',
      sending: 'Wysyłanie…',
      success: 'Dziękuję. Wiadomość została wysłana.',
      error: 'Nie udało się wysłać formularza. Spróbuj ponownie za chwilę.',
    };

const topicOptions = [
  { value: 'intro-call', label: c.introCall },
  { value: 'coaching-session', label: c.coachingSession },
  { value: 'mentoring-session', label: c.mentoringSession },
  { value: 'cv-review', label: c.cvReview },
  { value: 'linkedin-review', label: c.linkedinReview },
  { value: 'interview-preparation', label: c.interviewPreparation },
  { value: 'coaching-package', label: c.coachingPackage },
  { value: 'mentoring-package', label: c.mentoringPackage },
  { value: 'other', label: c.other },
];
---

<div class="contact-form-wrapper">
  <form
    id="contact-form"
    class="contact-form"
    name="irmaro-contact"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    data-success={c.success}
    data-error={c.error}
    data-sending={c.sending}
  >
    <input type="hidden" name="form-name" value="irmaro-contact" />
    <input type="hidden" name="language" value={lang} />
    <input type="hidden" name="package-sessions" value="" data-package-sessions />

    <p class="honeypot">
      <label>
        Do not fill this field:
        <input name="bot-field" />
      </label>
    </p>

    <div class="field field-full">
      <label for={`topic-${lang}`}>{c.topic}</label>

      <div class="select-wrap">
        <select
          id={`topic-${lang}`}
          name="topic"
          required
          data-topic-select
        >
          <option value="" selected disabled>
            {c.topicPlaceholder}
          </option>

          {topicOptions.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>

        <span class="select-arrow" aria-hidden="true">↓</span>
      </div>
    </div>

    <div class="form-grid">
      <div class="field">
        <label for={`name-${lang}`}>{c.name}</label>
        <input
          id={`name-${lang}`}
          name="name"
          type="text"
          autocomplete="name"
          required
        />
      </div>

      <div class="field">
        <label for={`email-${lang}`}>{c.email}</label>
        <input
          id={`email-${lang}`}
          name="email"
          type="email"
          autocomplete="email"
          required
        />
      </div>
    </div>

    <div class="field field-full phone-field">
      <label for={`phone-${lang}`}>{c.phone}</label>
      <input
        id={`phone-${lang}`}
        name="phone"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        placeholder={c.phonePlaceholder}
      />
    </div>

    <div class="field field-full message-field">
      <label for={`message-${lang}`}>{c.message}</label>
      <textarea
        id={`message-${lang}`}
        name="message"
        rows="6"
        placeholder={c.messagePlaceholder}
      ></textarea>
    </div>

    <p class="privacy-note">
      {c.privacy}
      <a href={c.privacyHref}>{c.privacyLabel}</a>.
    </p>

    <div class="form-actions">
      <button class="submit-button" type="submit">
        {c.submit}
      </button>
    </div>

    <p
      class="form-status"
      role="status"
      aria-live="polite"
      data-form-status
    ></p>
  </form>
</div>

<script is:inline>
  const form = document.querySelector('#contact-form');
  const topicSelect = form?.querySelector('[data-topic-select]');
  const packageSessions = form?.querySelector('[data-package-sessions]');
  const status = form?.querySelector('[data-form-status]');
  const submitButton = form?.querySelector('button[type="submit"]');

  const params = new URLSearchParams(window.location.search);
  const topic = params.get('topic');
  const sessions = params.get('sessions');

  const allowedTopics = new Set([
    'intro-call',
    'coaching-session',
    'mentoring-session',
    'cv-review',
    'linkedin-review',
    'interview-preparation',
    'coaching-package',
    'mentoring-package',
    'other',
  ]);

  const restoreContext = () => {
    if (topic && allowedTopics.has(topic) && topicSelect) {
      topicSelect.value = topic;
    }

    if (packageSessions) {
      packageSessions.value = sessions || '';
    }
  };

  restoreContext();

  // Native fragment scrolling may happen before fonts and layout settle.
  const alignFormDeepLink = () => {
    if (window.location.hash !== '#contact-form' || !form) return;
    requestAnimationFrame(() => {
      const header = document.querySelector('.site-header');
      const headerHeight = header?.getBoundingClientRect().height ?? 68;
      const targetTop = window.scrollY + form.getBoundingClientRect().top - headerHeight - 24;
      window.scrollTo({ top: Math.max(0, targetTop), behavior: 'auto' });
    });
  };

  if (document.readyState === 'complete') alignFormDeepLink();
  else window.addEventListener('load', alignFormDeepLink, { once: true });
  document.fonts?.ready.then(alignFormDeepLink);
  window.addEventListener('hashchange', alignFormDeepLink);
  window.addEventListener('pageshow', alignFormDeepLink);

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!(form instanceof HTMLFormElement)) return;

    if (status) {
      status.textContent = '';
      status.className = 'form-status';
    }

    const originalButtonText = submitButton?.textContent || '';

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = form.dataset.sending || originalButtonText;
    }

    try {
      const formData = new FormData(form);
      const body = new URLSearchParams();

      for (const [key, value] of formData.entries()) {
        body.append(key, String(value));
      }

      const response = await fetch('/', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: body.toString(),
      });

      if (!response.ok) {
        throw new Error('Form submission failed');
      }

      form.reset();
      restoreContext();

      if (status) {
        status.textContent = form.dataset.success || 'Sent.';
        status.className = 'form-status success';
      }
    } catch (error) {
      if (status) {
        status.textContent = form.dataset.error || 'Something went wrong.';
        status.className = 'form-status error';
      }
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = originalButtonText;
      }
    }
  });
</script>

<style>
  .contact-form-wrapper {
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
  }

  .contact-form {
    scroll-margin-top: 120px;
    width: 100%;
    padding: clamp(24px, 3vw, 36px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
  }

  .field {
    min-width: 0;
  }

  .field-full {
    width: 100%;
  }

  .field + .form-grid,
  .form-grid + .field,
  .contact-form > .field + .field {
    margin-top: 28px;
  }

  .field label {
    display: block;
    margin-bottom: 10px;
    color: var(--text);
    font-family: "Arial Narrow", "Aptos Narrow", sans-serif;
    font-size: .76rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    margin: 0;
    padding: 8px 0 11px;
    border: 0;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    outline: none;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: .96rem;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: color-mix(in srgb, var(--muted) 62%, transparent);
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-bottom-color: var(--brand-dark);
  }

  .select-wrap {
    position: relative;
  }

  .select-wrap select {
    padding-right: 30px;
    appearance: none;
    cursor: pointer;
  }

  .select-arrow {
    position: absolute;
    top: 50%;
    right: 4px;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--brand-dark);
    font-size: .82rem;
  }

  .message-field textarea {
    min-height: 120px;
    resize: vertical;
  }

  .privacy-note {
    max-width: 620px;
    margin: 22px 0 0;
    color: var(--muted);
    font-size: .72rem;
    line-height: 1.55;
  }

  .privacy-note a {
    color: var(--brand-dark) !important;
    text-underline-offset: 3px;
  }

  .form-actions {
    display: flex;
    justify-content: flex-start;
    margin-top: 24px;
  }

  .submit-button {
    min-height: 42px;
    padding: 0 20px;
    border: 1px solid var(--brand-dark);
    border-radius: 4px;
    background: var(--brand-dark);
    color: white;
    font: inherit;
    font-size: .88rem;
    font-weight: 800;
    cursor: pointer;
    transition: opacity .18s ease, transform .18s ease;
  }

  .submit-button:hover {
    opacity: .9;
  }

  .submit-button:active {
    transform: translateY(1px);
  }

  .submit-button:disabled {
    cursor: wait;
    opacity: .55;
  }

  .form-status {
    min-height: 1.35em;
    margin: 18px 0 0;
    font-size: .82rem;
  }

  .form-status.success {
    color: var(--moss-dark);
  }

  .form-status.error {
    color: #8b3f32;
  }

  @media (max-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
