---
import '../styles/irma-refresh.css';
type PageKey =
  | 'home'
  | 'about'
  | 'offer'
  | 'booking'
  | 'perspectives'
  | 'contact'
  | 'privacy'
  | 'terms';

interface Props {
  lang: 'en' | 'pl';
  pageKey: PageKey;
  alternateHref?: string;
}

const { lang, pageKey, alternateHref } = Astro.props;
const isEn = lang === 'en';

const routes: Record<PageKey, { en: string; pl: string }> = {
  home: { en: '/en/', pl: '/pl/' },
  about: { en: '/en/about/', pl: '/pl/o-mnie/' },
  offer: { en: '/en/offer/', pl: '/pl/oferta/' },
  booking: { en: '/en/book-a-session/', pl: '/pl/umow-sesje/' },
  perspectives: { en: '/en/perspectives/', pl: '/pl/perspektywy/' },
  contact: { en: '/en/contact/', pl: '/pl/kontakt/' },
  privacy: { en: '/en/privacy-policy/', pl: '/pl/polityka-prywatnosci/' },
  terms: { en: '/en/terms/', pl: '/pl/regulamin/' },
};

const perspectiveItems = isEn
  ? [
      { label: 'What Coaching Means to Me', href: '/en/perspectives/what-coaching-means-to-me/' },
      { label: 'Emotional Account', href: '/en/perspectives/emotional-account/' },
      { label: 'Wise Love', href: '/en/perspectives/wise-love/' },
      { label: 'Parenting Against Nature', href: '/en/perspectives/unnatural-parenting/' },
      { label: 'Change', href: '/en/perspectives/change/' },
      { label: 'Sleepwalking Through Life', href: '/en/perspectives/sleepwalking-through-life/' },
      { label: 'Friendship in Expat Life', href: '/en/perspectives/friendship-in-expat-life/' },
    ]
  : [
      { label: 'Co coaching znaczy dla mnie', href: '/pl/perspektywy/co-coaching-znaczy-dla-mnie/' },
      { label: 'Konto emocjonalne', href: '/pl/perspektywy/konto-emocjonalne/' },
      { label: 'Mądra miłość', href: '/pl/perspektywy/madra-milosc/' },
      { label: 'Wynaturzone rodzicielstwo', href: '/pl/perspektywy/wynaturzone-rodzicielstwo/' },
      { label: 'Zmiany', href: '/pl/perspektywy/zmiany/' },
      { label: 'Uśpienie', href: '/pl/perspektywy/uspienie/' },
      { label: 'Przyjaźń emigracyjna', href: '/pl/perspektywy/przyjazn-emigracyjna/' },
    ];

const offerItems = isEn
  ? [
      { label: 'Coaching', href: '/en/offer/coaching/' },
      { label: 'Mentoring', href: '/en/offer/mentoring/' },
    ]
  : [
      { label: 'Coaching', href: '/pl/oferta/coaching/' },
      { label: 'Mentoring', href: '/pl/oferta/mentoring/' },
    ];

const otherLangHref = alternateHref ?? (isEn ? routes[pageKey].pl : routes[pageKey].en);
const currentHref = Astro.url.pathname;
---

<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href={routes.home[lang]}>
      <strong>Irma Rosenvik</strong>
      <span>Life &amp; Career Coach · Mentor</span>
    </a>

    <div class="right">
      <nav class="nav" data-nav aria-label={isEn ? 'Main navigation' : 'Główna nawigacja'}>
        <a
          href={routes.home[lang]}
          class:list={{ active: pageKey === 'home' }}
          aria-current={pageKey === 'home' ? 'page' : undefined}
        >
          {isEn ? 'Home' : 'Start'}
        </a>

        <a
          href={routes.about[lang]}
          class:list={{ active: pageKey === 'about' }}
          aria-current={pageKey === 'about' ? 'page' : undefined}
        >
          {isEn ? 'About' : 'O mnie'}
        </a>

        <div class:list={['nav-dropdown', { active: pageKey === 'perspectives' }]} data-dropdown>
          <div class="dropdown-trigger">
            <a
              href={routes.perspectives[lang]}
              class:list={{ active: pageKey === 'perspectives' }}
              aria-current={pageKey === 'perspectives' ? 'page' : undefined}
            >
              {isEn ? 'Perspectives' : 'Perspektywy'}
            </a>
            <button
              class="dropdown-toggle"
              type="button"
              aria-label={isEn ? 'Show Perspective articles' : 'Pokaż wpisy Perspektyw'}
              aria-expanded="false"
              data-dropdown-toggle
            >
              <span class="dropdown-indicator" aria-hidden="true"><i></i><b></b></span>
            </button>
          </div>

          <div class="dropdown-submenu">
            {perspectiveItems.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </div>
        </div>

        <div class:list={['nav-dropdown', { active: pageKey === 'offer' }]} data-dropdown>
          <div class="dropdown-trigger">
            <a
              href={routes.offer[lang]}
              class:list={{ active: pageKey === 'offer' }}
              aria-current={pageKey === 'offer' ? 'page' : undefined}
            >
              {isEn ? 'Offer' : 'Oferta'}
            </a>
            <button
              class="dropdown-toggle"
              type="button"
              aria-label={isEn ? 'Show Offer sections' : 'Pokaż sekcje Oferty'}
              aria-expanded="false"
              data-dropdown-toggle
            >
              <span class="dropdown-indicator" aria-hidden="true"><i></i><b></b></span>
            </button>
          </div>

          <div class="dropdown-submenu">
            {offerItems.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </div>
        </div>

        <a
          href={routes.booking[lang]}
          class:list={{ active: pageKey === 'booking' }}
          aria-current={pageKey === 'booking' ? 'page' : undefined}
        >
          {isEn ? 'Pricing' : 'Cennik'}
        </a>

        <a
          href={routes.contact[lang]}
          class:list={{ active: pageKey === 'contact' }}
          aria-current={pageKey === 'contact' ? 'page' : undefined}
        >
          {isEn ? 'Contact' : 'Kontakt'}
        </a>
      </nav>

      {false && (
<div class="language-switch" aria-label={isEn ? 'Language switcher' : 'Przełącznik języka'}>
        <a
          href={isEn ? otherLangHref : currentHref}
          class:list={{ active: !isEn }}
          aria-current={!isEn ? 'page' : undefined}
          aria-label="Polski"
        >
          <img src="/images/flag-pl.svg" alt="" aria-hidden="true" />
          <span>PL</span>
        </a>

        <span class="separator">/</span>

        <a
          href={isEn ? currentHref : otherLangHref}
          class:list={{ active: isEn }}
          aria-current={isEn ? 'page' : undefined}
          aria-label="English"
        >
          <img src="/images/flag-gb.svg" alt="" aria-hidden="true" />
          <span>EN</span>
        </a>
      </div>
      )}

      <button
        class="menu-button"
        type="button"
        aria-label={isEn ? 'Open menu' : 'Otwórz menu'}
        aria-expanded="false"
        data-menu-button
      >
        Menu
      </button>
    </div>
  </div>
</header>

<script is:inline>
  const menuButton = document.querySelector('[data-menu-button]');
  const nav = document.querySelector('[data-nav]');

  menuButton?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    menuButton.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  document.querySelectorAll('[data-dropdown]').forEach((dropdown) => {
    const toggle = dropdown.querySelector('[data-dropdown-toggle]');

    const closeDropdown = () => {
      dropdown.classList.remove('submenu-open');
      toggle?.setAttribute('aria-expanded', 'false');
    };

    toggle?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();

      document.querySelectorAll('[data-dropdown].submenu-open').forEach((openDropdown) => {
        if (openDropdown !== dropdown) {
          openDropdown.classList.remove('submenu-open');
          openDropdown.querySelector('[data-dropdown-toggle]')?.setAttribute('aria-expanded', 'false');
        }
      });

      const isOpen = dropdown.classList.toggle('submenu-open');
      toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
    });

    dropdown.addEventListener('mouseleave', () => {
      if (window.matchMedia('(min-width: 1081px)').matches) {
        closeDropdown();
      }
    });

    dropdown.querySelectorAll('.dropdown-submenu a').forEach((link) => {
      link.addEventListener('click', closeDropdown);
    });
  });

  document.addEventListener('pointerdown', (event) => {
    if (!(event.target instanceof Node)) return;

    document.querySelectorAll('[data-dropdown].submenu-open').forEach((dropdown) => {
      if (!dropdown.contains(event.target)) {
        dropdown.classList.remove('submenu-open');
        dropdown.querySelector('[data-dropdown-toggle]')?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;

    document.querySelectorAll('[data-dropdown].submenu-open').forEach((dropdown) => {
      dropdown.classList.remove('submenu-open');
      dropdown.querySelector('[data-dropdown-toggle]')?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 95%, transparent);
    backdrop-filter: blur(10px);
  }

  .nav-wrap {
    position: relative;
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: 1px;
    color: var(--text) !important;
    text-decoration: none !important;
    line-height: 1.05;
  }

  .brand strong {
    font-family: "Arial Narrow", "Aptos Narrow", sans-serif;
    font-size: 1rem;
    letter-spacing: .035em;
  }

  .brand span {
    color: var(--muted);
    font-size: .62rem;
    letter-spacing: .04em;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .nav > a,
  .dropdown-trigger > a {
    position: relative;
    padding: 23px 0 20px;
    color: var(--muted) !important;
    text-decoration: none !important;
    font-size: .84rem;
    font-weight: 600;
  }

  .nav > a::after,
  .dropdown-trigger > a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 14px;
    height: 1px;
    background: transparent;
  }

  .nav > a:hover,
  .nav > a.active,
  .dropdown-trigger > a:hover,
  .dropdown-trigger > a.active {
    color: var(--text) !important;
  }

  .nav > a.active::after,
  .nav > a[aria-current="page"]::after,
  .dropdown-trigger > a.active::after,
  .dropdown-trigger > a[aria-current="page"]::after {
    background: var(--brand-dark) !important;
  }

  .nav-dropdown {
    position: relative;
  }

  .dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .dropdown-toggle {
    display: inline-grid;
    width: 24px;
    height: 30px;
    padding: 0;
    place-items: center;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .nav-dropdown:hover .dropdown-toggle,
  .nav-dropdown.active .dropdown-toggle {
    color: var(--text);
  }

  .dropdown-submenu {
    position: absolute;
    top: calc(100% - 7px);
    left: -18px;
    z-index: 30;
    width: max-content;
    min-width: 210px;
    max-width: min(340px, 82vw);
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    box-shadow: 0 16px 38px rgba(39, 35, 28, .1);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity .16s ease,
      transform .16s ease,
      visibility .16s ease;
  }

  .dropdown-submenu a {
    display: block;
    padding: 9px 10px;
    color: var(--text) !important;
    text-decoration: none !important;
    font-size: .82rem;
    line-height: 1.35;
  }

  .dropdown-submenu a:hover {
    background: var(--moss-extra-light);
  }

  .nav-dropdown.submenu-open .dropdown-submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .language-switch {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--muted);
    font-size: .72rem;
  }

  .language-switch a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--muted) !important;
    text-decoration: none !important;
  }

  .language-switch a.active {
    color: var(--text) !important;
    font-weight: 800;
  }

  .language-switch img {
    width: 16px;
    height: 11px;
    object-fit: cover;
    border: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
  }

  .separator {
    opacity: .55;
  }

  .menu-button {
    display: none;
    min-height: 38px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: .82rem;
    font-weight: 700;
  }

  @media (max-width: 1080px) {
    .menu-button {
      display: inline-flex;
      align-items: center;
    }

    .nav {
      position: absolute;
      top: calc(100% + 1px);
      left: 16px;
      right: 16px;
      display: none;
      padding: 10px;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--bg);
      box-shadow: 0 18px 36px rgba(39, 35, 28, .09);
    }

    .nav.open {
      display: flex;
    }

    .nav > a,
    .dropdown-trigger > a {
      padding: 11px 10px;
    }

    .nav > a::after,
    .dropdown-trigger > a::after {
      display: none;
    }

    .dropdown-trigger {
      justify-content: space-between;
    }

    .dropdown-trigger > a {
      flex: 1;
    }

    .dropdown-toggle {
      width: 42px;
      height: 42px;
    }

    .dropdown-submenu {
      position: static;
      display: none;
      width: 100%;
      max-width: none;
      min-width: 0;
      padding: 0 0 8px 14px;
      border: 0;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      background: transparent;
    }

    .nav-dropdown.submenu-open .dropdown-submenu {
      display: block;
    }

    .dropdown-submenu a {
      padding: 8px 10px;
    }
  }

  @media (max-width: 620px) {
    .brand span {
      max-width: 180px;
    }

    .right {
      gap: 10px;
    }

    .language-switch span:not(.separator) {
      display: none;
    }
  }
</style>
