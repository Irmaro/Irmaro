---
type PageKey =
  | 'home'
  | 'about'
  | 'offer'
  | 'booking'
  | 'perspectives'
  | 'contact'
  | 'privacy'
  | 'terms';

interface Props {
  lang: 'en' | 'pl';
  pageKey: PageKey;
  alternateHref?: string;
}

const { lang, pageKey, alternateHref } = Astro.props;
const isEn = lang === 'en';

const routes: Record<PageKey, { en: string; pl: string }> = {
  home: { en: '/en/', pl: '/pl/' },
  about: { en: '/en/about/', pl: '/pl/o-mnie/' },
  offer: { en: '/en/offer/', pl: '/pl/oferta/' },
  booking: { en: '/en/book-a-session/', pl: '/pl/umow-sesje/' },
  perspectives: { en: '/en/perspectives/', pl: '/pl/perspektywy/' },
  contact: { en: '/en/contact/', pl: '/pl/kontakt/' },
  privacy: { en: '/en/privacy-policy/', pl: '/pl/polityka-prywatnosci/' },
  terms: { en: '/en/terms/', pl: '/pl/regulamin/' },
};

const navBeforeOffer = isEn
  ? [
      { key: 'home' as PageKey, label: 'Home' },
      { key: 'about' as PageKey, label: 'About' },
    ]
  : [
      { key: 'home' as PageKey, label: 'Start' },
      { key: 'about' as PageKey, label: 'O mnie' },
    ];

const navAfterOffer = isEn
  ? [
      { key: 'booking' as PageKey, label: 'Work with me' },
      { key: 'perspectives' as PageKey, label: 'Perspectives' },
      { key: 'contact' as PageKey, label: 'Contact' },
    ]
  : [
      { key: 'booking' as PageKey, label: 'Współpraca' },
      { key: 'perspectives' as PageKey, label: 'Perspektywy' },
      { key: 'contact' as PageKey, label: 'Kontakt' },
    ];

const offerItems = isEn
  ? [
      { label: 'Coaching', href: '/en/offer/#coaching' },
      { label: 'Career mentoring', href: '/en/offer/#career-mentoring' },
      { label: 'Interview preparation', href: '/en/offer/#interview-preparation' },
      { label: 'Life mentoring', href: '/en/offer/#life-mentoring' },
    ]
  : [
      { label: 'Coaching', href: '/pl/oferta/#coaching' },
      { label: 'Mentoring kariery zawodowej', href: '/pl/oferta/#career-mentoring' },
      { label: 'Przygotowanie do rozmowy rekrutacyjnej', href: '/pl/oferta/#interview-preparation' },
      { label: 'Mentoring życia', href: '/pl/oferta/#life-mentoring' },
    ];

const otherLangHref = alternateHref ?? (isEn ? routes[pageKey].pl : routes[pageKey].en);
const currentHref = Astro.url.pathname;
---

<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href={routes.home[lang]}>
      <strong>Irma Rosenvik</strong>
      <span>Life &amp; Career Coach · Mentor</span>
    </a>

    <div class="right">
      <nav class="nav" data-nav aria-label={isEn ? 'Main navigation' : 'Główna nawigacja'}>
        {
          navBeforeOffer.map((item) => (
            <a
              href={routes[item.key][lang]}
              class:list={{ active: item.key === pageKey }}
              aria-current={item.key === pageKey ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }

        <div class:list={['nav-offer', { active: pageKey === 'offer' }]} data-offer-menu>
          <div class="offer-trigger">
            <a
              href={routes.offer[lang]}
              class:list={{ active: pageKey === 'offer' }}
              aria-current={pageKey === 'offer' ? 'page' : undefined}
            >
              {isEn ? 'Offer' : 'Oferta'}
            </a>

            <button
              class="offer-toggle"
              type="button"
              aria-label={isEn ? 'Show Offer sections' : 'Pokaż sekcje Oferty'}
              aria-expanded="false"
              data-offer-toggle
            >
              <span aria-hidden="true">⌄</span>
            </button>
          </div>

          <div class="offer-submenu" data-offer-submenu>
            {
              offerItems.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))
            }
          </div>
        </div>

        {
          navAfterOffer.map((item) => (
            <a
              href={routes[item.key][lang]}
              class:list={{ active: item.key === pageKey }}
              aria-current={item.key === pageKey ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="language-switch" aria-label={isEn ? 'Language switcher' : 'Przełącznik języka'}>
        <a
          href={isEn ? otherLangHref : currentHref}
          class:list={{ active: !isEn }}
          aria-current={!isEn ? 'page' : undefined}
          aria-label="Polski"
        >
          <img src="/images/flag-pl.svg" alt="" aria-hidden="true" />
          <span>PL</span>
        </a>

        <span class="separator">/</span>

        <a
          href={isEn ? currentHref : otherLangHref}
          class:list={{ active: isEn }}
          aria-current={isEn ? 'page' : undefined}
          aria-label="English"
        >
          <img src="/images/flag-gb.svg" alt="" aria-hidden="true" />
          <span>EN</span>
        </a>
      </div>

      <button
        class="menu-button"
        type="button"
        aria-label={isEn ? 'Open menu' : 'Otwórz menu'}
        aria-expanded="false"
        data-menu-button
      >
        Menu
      </button>
    </div>
  </div>
</header>

<script is:inline>
  const menuButton = document.querySelector('[data-menu-button]');
  const nav = document.querySelector('[data-nav]');
  const offerToggle = document.querySelector('[data-offer-toggle]');
  const offerMenu = document.querySelector('[data-offer-menu]');

  menuButton?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    menuButton.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  offerToggle?.addEventListener('click', (event) => {
    event.preventDefault();
    event.stopPropagation();

    const isOpen = offerMenu?.classList.toggle('submenu-open');
    offerToggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 95%, transparent);
    backdrop-filter: blur(10px);
  }

  .nav-wrap {
    position: relative;
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: 1px;
    color: var(--text) !important;
    text-decoration: none !important;
    line-height: 1.05;
  }

  .brand strong {
    font-family: "Arial Narrow", "Aptos Narrow", sans-serif;
    font-size: 1rem;
    letter-spacing: .035em;
  }

  .brand span {
    color: var(--muted);
    font-size: .62rem;
    letter-spacing: .04em;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .nav > a,
  .offer-trigger > a {
    position: relative;
    padding: 23px 0 20px;
    color: var(--muted) !important;
    text-decoration: none !important;
    font-size: .84rem;
    font-weight: 600;
  }

  .nav > a::after,
  .offer-trigger > a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 14px;
    height: 1px;
    background: transparent;
  }

  .nav > a:hover,
  .nav > a.active,
  .offer-trigger > a:hover,
  .offer-trigger > a.active {
    color: var(--text) !important;
  }

  .nav > a.active::after,
  .nav > a[aria-current="page"]::after,
  .offer-trigger > a.active::after,
  .offer-trigger > a[aria-current="page"]::after {
    background: var(--brand-dark) !important;
  }

  .nav-offer {
    position: relative;
  }

  .offer-trigger {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .offer-toggle {
    display: inline-flex;
    width: 20px;
    height: 28px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--brand-dark);
    cursor: pointer;
    font: inherit;
    font-size: .9rem;
    line-height: 1;
  }

  .offer-submenu {
    display: none;
    position: absolute;
    top: calc(100% - 7px);
    left: -14px;
    z-index: 30;
    width: max-content;
    min-width: 260px;
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    box-shadow: 0 12px 30px rgba(39,35,28,.09);
  }

  .offer-submenu a {
    display: block;
    padding: 7px 10px;
    border-radius: 4px;
    color: var(--muted) !important;
    text-decoration: none !important;
    font-size: .82rem;
    line-height: 1.25;
  }

  .offer-submenu a:hover,
  .offer-submenu a:focus-visible {
    background: var(--moss-extra-light);
    color: var(--moss-dark) !important;
  }

  @media (min-width: 981px) {
    .nav-offer:hover .offer-submenu,
    .nav-offer:focus-within .offer-submenu,
    .nav-offer.submenu-open .offer-submenu {
      display: block;
    }
  }

  .language-switch {
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    font-size: .78rem;
  }

  .language-switch a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--muted) !important;
    text-decoration: none !important;
  }

  .language-switch img {
    width: 18px;
    height: 12px;
    object-fit: cover;
    border: 1px solid rgba(39,35,28,.12);
    border-radius: 1px;
  }

  .language-switch a.active {
    color: var(--text) !important;
    font-weight: 800;
    text-decoration: underline !important;
    text-decoration-color: var(--brand-dark) !important;
    text-underline-offset: 4px;
  }

  .language-switch a:hover {
    color: var(--brand-dark) !important;
  }

  .separator {
    color: var(--border);
  }

  .menu-button {
    display: none;
    padding: 7px 11px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: .82rem;
  }

  @media (max-width: 980px) {
    .menu-button {
      display: inline-flex;
    }

    .nav {
      display: none;
      position: absolute;
      top: 68px;
      left: 16px;
      right: 16px;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 5px 14px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg);
      box-shadow: 0 12px 30px rgba(39,35,28,.08);
    }

    .nav.open {
      display: flex;
    }

    .nav > a,
    .offer-trigger > a {
      padding: 3px 0;
    }

    .nav > a::after,
    .offer-trigger > a::after {
      bottom: 0;
    }

    .nav-offer {
      width: 100%;
    }

    .offer-trigger {
      justify-content: space-between;
    }

    .offer-toggle {
      width: 32px;
      height: 26px;
    }

    .offer-submenu {
      position: static;
      width: 100%;
      min-width: 0;
      margin: 2px 0 3px;
      padding: 2px 0 2px 12px;
      border: 0;
      border-left: 1px solid var(--brand-light);
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    .nav-offer.submenu-open .offer-submenu {
      display: block;
    }

    .offer-submenu a {
      padding: 3px 0;
      font-size: .79rem;
    }

    .offer-submenu a:hover,
    .offer-submenu a:focus-visible {
      background: transparent;
      color: var(--moss-dark) !important;
    }
  }

  @media (max-width: 560px) {
    .brand span {
      display: none;
    }

    .right {
      gap: 9px;
    }

    .language-switch {
      gap: 4px;
      font-size: .74rem;
    }

    .language-switch img {
      width: 16px;
      height: 11px;
    }
  }
</style>
