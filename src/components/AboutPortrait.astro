---
import { media } from '../config/media';

interface Props {
  lang: 'en' | 'pl';
}

Astro.props as Props;

const portraitSrc = media.aboutPortrait;
---

<figure class="about-portrait">
  <div class="portrait-circle">
    <img
      src={portraitSrc}
      alt="Irma Rosenvik"
      loading="eager"
      decoding="async"
    />
  </div>
</figure>

<style>
  .about-portrait {
    width: 210px;
    max-width: 100%;
    margin: 0 auto;
  }

  .portrait-circle {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    background: var(--surface);
  }

  .portrait-circle img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;

    /* LinkedIn-style crop: full head + shoulders, without the large empty wall. */
    object-position: center 38%;
  }

  @media (max-width: 820px) {
    .about-portrait {
      width: 190px;
    }
  }
</style>
