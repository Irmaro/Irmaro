---
import { existsSync, readdirSync } from 'node:fs';
import { extname, join } from 'node:path';
import { media } from '../config/media';

const configuredSrc = media.aboutPortrait;
const normalizedSrc = configuredSrc.replace(/^\/+/, '');
const configuredFile = join(process.cwd(), 'public', normalizedSrc);

const ignoredNames = /logo|flag|favicon|icon|tree|banner|baner/i;

let portraitSrc = configuredSrc;

if (!existsSync(configuredFile)) {
  const imagesDir = join(process.cwd(), 'public', 'images');

  try {
    const files = readdirSync(imagesDir).filter((file) => {
      const ext = extname(file).toLowerCase();
      const isImage = ['.jpg', '.jpeg', '.png', '.webp', '.avif'].includes(ext);
      return isImage && !ignoredNames.test(file);
    });

    const preferred =
      files.find((file) => /irma.*(about|portrait)|(?:about|portrait).*irma/i.test(file)) ??
      files.find((file) => /irma/i.test(file)) ??
      files.find((file) => /(about|portrait)/i.test(file)) ??
      files[0];

    if (preferred) {
      portraitSrc = encodeURI(`/images/${preferred}`);
    }
  } catch {
    portraitSrc = configuredSrc;
  }
}
---

<figure class="about-portrait">
  <div class="portrait-crop">
    <img
      src={portraitSrc}
      alt="Irma Rosenvik"
      loading="eager"
      decoding="async"
    />
  </div>
</figure>

<style>
  .about-portrait {
    width: 74%;
    margin: 0 auto;
    align-self: start;
  }

  /*
    Longer portrait: preserve the full head and the lower part
    of the original photo, including folded arms.
    Only a small amount of empty wall above the head is removed.
  */
  .portrait-crop {
    width: 100%;
    overflow: hidden;
  }

  .portrait-crop img {
    width: 100%;
    height: auto;
    display: block;

    /*
      Approx. 8% top crop:
      enough to reduce the empty wall,
      but much less aggressive than the previous 20% crop.
    */
    clip-path: inset(22% 0 0 0);
    margin-top: -22%;
  }

  @media (max-width: 820px) {
    .about-portrait {
      width: min(340px, 82%);
      margin: 0 auto;
    }
  }
</style>
