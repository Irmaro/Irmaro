---
import { existsSync, readdirSync } from 'node:fs';
import { extname, join } from 'node:path';
import { media } from '../config/media';

interface Props {
  lang: 'en' | 'pl';
}

const { lang } = Astro.props;

const configuredSrc = media.aboutPortrait;

const configuredFile = join(
  process.cwd(),
  'public',
  configuredSrc.replace(/^\//, '')
);

let portraitSrc = configuredSrc;

/*
  Nie zmieniamy nazwy ani pliku zdjęcia.

  Najpierw używana jest ścieżka z:
  src/config/media.ts

  Jeżeli z jakiegoś powodu wskazuje ona na nieistniejący plik,
  komponent próbuje znaleźć istniejące zdjęcie Irmy
  w public/images.
*/
if (!existsSync(configuredFile)) {
  const imagesDir = join(process.cwd(), 'public', 'images');

  try {
    const files = readdirSync(imagesDir).filter((file) => {
      const ext = extname(file).toLowerCase();

      const isImage = [
        '.jpg',
        '.jpeg',
        '.png',
        '.webp',
        '.avif',
      ].includes(ext);

      const isBrandAsset =
        /logo|flag|favicon|icon/i.test(file);

      return isImage && !isBrandAsset;
    });

    const preferred =
      files.find((file) =>
        /irma.*(about|portrait)|(?:about|portrait).*irma/i.test(file)
      ) ??
      files.find((file) => /irma/i.test(file)) ??
      files.find((file) => /about|portrait/i.test(file)) ??
      files[0];

    if (preferred) {
      portraitSrc = `/images/${preferred}`;
    }
  } catch {
    portraitSrc = configuredSrc;
  }
}
---

<figure class="about-portrait">
  <div class="portrait-frame">
    <img
      src={portraitSrc}
      alt="Irma Rosenvik"
      loading="eager"
      decoding="async"
    />
  </div>
</figure>

<style>
  .about-portrait {
    width: 100%;
    margin: 0;
    align-self: start;
  }

  .portrait-frame {
    width: 100%;

    /*
      Kadr jest wysoki, dzięki czemu zachowujemy:
      - całą głowę,
      - sylwetkę,
      - złożone ręce.

      Nadmiar kadru wycinamy przede wszystkim od góry.
    */
    aspect-ratio: 2 / 3;

    padding: 8px;

    border: 1px solid
      color-mix(
        in srgb,
        var(--moss) 36%,
        var(--border)
      );

    border-radius: var(--radius);

    background: var(--moss-extra-light);

    overflow: hidden;
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;

    display: block;

    /*
      Zdjęcie wypełnia ramkę.
    */
    object-fit: cover;

    /*
      Najważniejsza linia:

      kotwiczymy zdjęcie DO DOŁU.

      Dzięki temu:
      - ręce zostają,
      - dół zdjęcia nie jest obcinany,
      - jeśli coś trzeba przyciąć, przeglądarka
        zabiera przestrzeń przede wszystkim z góry.
    */
    object-position: center 90%;

    border-radius: calc(var(--radius) - 4px);
  }

  @media (max-width: 820px) {
    .about-portrait {
      width: min(430px, 100%);
    }

    .portrait-frame {
      aspect-ratio: 2 / 3;
    }
  }
</style>