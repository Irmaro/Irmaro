---
import { site } from '../config/site';

interface Props {
  lang: 'en' | 'pl';
}

const { lang } = Astro.props;
const isEn = lang === 'en';

const nav = isEn
  ? [
      { label: 'About', href: '/en/about/' },
      { label: 'Offer', href: '/en/offer/' },
      { label: 'Book a session', href: '/en/book-a-session/' },
      { label: 'Perspectives', href: '/en/perspectives/' },
      { label: 'Contact', href: '/en/contact/' },
    ]
  : [
      { label: 'O mnie', href: '/pl/o-mnie/' },
      { label: 'Oferta', href: '/pl/oferta/' },
      { label: 'Umów sesję', href: '/pl/umow-sesje/' },
      { label: 'Perspektywy', href: '/pl/perspektywy/' },
      { label: 'Kontakt', href: '/pl/kontakt/' },
    ];
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <div class="footer-logo-crop">
        <img
          src={site.logoPath}
          alt="irmaro"
          class="footer-logo"
          loading="lazy"
        />
      </div>
    </div>

    <div class="footer-right">
      <nav
        class="footer-nav"
        aria-label={isEn ? 'Footer navigation' : 'Nawigacja w stopce'}
      >
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <div class="footer-meta">
        <a
          href={site.linkedInUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>

        <a href={isEn ? '/en/privacy-policy/' : '/pl/polityka-prywatnosci/'}>
          {isEn ? 'Privacy Policy' : 'Polityka prywatności'}
        </a>

        <a href={isEn ? '/en/terms/' : '/pl/regulamin/'}>
          {isEn ? 'Terms' : 'Regulamin'}
        </a>

        <span class="footer-language">
          <a href="/pl/">PL</a>
          <span>/</span>
          <a href="/en/">EN</a>
        </span>
      </div>
    </div>

    <div class="footer-tagline">
      {isEn ? 'Change Begins Here' : 'Tu zaczyna się zmiana'}
    </div>

    <div class="footer-copyright">
      © {new Date().getFullYear()} irmaro
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 0 0 6px;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(220px, 350px) 1fr;
    grid-template-areas:
      "brand nav"
      "tagline copyright";
    column-gap: 28px;
    row-gap: 6px;
    padding-top: 8px;
    align-items: start;
  }

  .footer-brand {
    grid-area: brand;
    display: flex;
    align-items: flex-start;
  }

  /*
    Uses the ORIGINAL logo from site.logoPath.
    The wrapper crops only the blank pixels inside that PNG.
    Visible artwork is approx. 25% smaller than the earlier footer version.
  */
  .footer-logo-crop {
    position: relative;
    width: 156px;
    height: 112px;
    overflow: hidden;
  }

  .footer-logo {
    position: absolute;
    width: 189px;
    max-width: none;
    height: auto;
    left: -24px;
    top: -12px;
    display: block;
  }

  .footer-right {
    grid-area: nav;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-start;
    gap: 8px;
    padding-top: 0;
  }

  .footer-nav,
  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 6px 15px;
  }

  .footer-nav a,
  .footer-meta a {
    color: var(--muted) !important;
    text-decoration: none !important;
    font-size: .78rem;
    font-weight: 600;
    line-height: 1.15;
  }

  .footer-nav a:hover,
  .footer-meta a:hover {
    color: var(--moss-dark) !important;
  }

  .footer-language {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--muted);
    font-size: .78rem;
  }

  .footer-tagline,
  .footer-copyright {
    margin: 0;
    color: var(--muted);
    font-size: .94rem;
    font-weight: 500;
    line-height: 1.15;
  }

  .footer-tagline {
    grid-area: tagline;
    justify-self: start;
  }

  .footer-copyright {
    grid-area: copyright;
    justify-self: end;
    text-align: right;
  }

  @media (max-width: 900px) {
    .footer-main {
      grid-template-columns: 1fr;
      grid-template-areas:
        "brand"
        "tagline"
        "nav"
        "copyright";
      row-gap: 7px;
      padding-top: 7px;
    }

    .footer-logo-crop {
      width: 126px;
      height: 81px;
    }

    .footer-logo {
      width: 153px;
      left: -18px;
      top: -9px;
    }

    .footer-right {
      align-items: flex-start;
      gap: 6px;
    }

    .footer-nav,
    .footer-meta {
      justify-content: flex-start;
      gap: 5px 12px;
    }

    .footer-tagline,
    .footer-copyright {
      font-size: .9rem;
    }

    .footer-copyright {
      justify-self: start;
      text-align: left;
    }
  }

  @media (max-width: 560px) {
    .footer-logo-crop {
      width: 113px;
      height: 90px;
    }

    .footer-logo {
      width: 137px;
      left: -20px;
      top: -10px;
    }
  }
</style>
