---
import { site } from '../config/site';

interface Props {
  lang: 'en' | 'pl';
}

const { lang } = Astro.props;
const isEn = lang === 'en';

const nav = isEn
  ? [
      { label: 'About', href: '/en/about/' },
      { label: 'Offer', href: '/en/offer/' },
      { label: 'Book a session', href: '/en/book-a-session/' },
      { label: 'Perspectives', href: '/en/perspectives/' },
      { label: 'Contact', href: '/en/contact/' },
    ]
  : [
      { label: 'O mnie', href: '/pl/o-mnie/' },
      { label: 'Oferta', href: '/pl/oferta/' },
      { label: 'Umów sesję', href: '/pl/umow-sesje/' },
      { label: 'Perspektywy', href: '/pl/perspektywy/' },
      { label: 'Kontakt', href: '/pl/kontakt/' },
    ];
---

<footer class="site-footer">
  <div class="container footer-main">

    <div class="footer-brand-block">
      <div class="footer-logo-crop">
        <img
          src={site.logoPath}
          alt="irmaro"
          class="footer-logo"
          loading="lazy"
        />
      </div>
    </div>

    <div class="footer-right">
      <nav
        class="footer-nav"
        aria-label={isEn ? 'Footer navigation' : 'Nawigacja w stopce'}
      >
        {
          nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>

      <div class="footer-meta">
        <a
          href={site.linkedInUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>

        <a
          href={
            isEn
              ? '/en/privacy-policy/'
              : '/pl/polityka-prywatnosci/'
          }
        >
          {isEn ? 'Privacy Policy' : 'Polityka prywatności'}
        </a>

        <a
          href={
            isEn
              ? '/en/terms/'
              : '/pl/regulamin/'
          }
        >
          {isEn ? 'Terms' : 'Regulamin'}
        </a>

        <span class="footer-language">
          <a href="/pl/">PL</a>
          <span>/</span>
          <a href="/en/">EN</a>
        </span>
      </div>
    </div>

    <div class="footer-tagline">
      {isEn ? 'Change Begins Here' : 'Tu zaczyna się zmiana'}
    </div>

    <div class="footer-copyright">
      © {new Date().getFullYear()} irmaro
    </div>

  </div>
</footer>

<style>
  .site-footer {
    padding: 0 0 6px;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  .footer-main {
    display: grid;

    grid-template-columns:
      minmax(255px, 390px)
      1fr;

    grid-template-areas:
      "brand nav"
      "tagline copyright";

    column-gap: 28px;
    row-gap: 8px;

    align-items: start;

    /* bardzo mały odstęp od kreski */
    padding-top: 3px;
  }

  /* =========================
     LOGO
     ========================= */

  .footer-brand-block {
    grid-area: brand;

    display: flex;
    align-items: flex-start;

    min-width: 0;
  }

  /*
    Oryginalny PNG ma sporo pustego miejsca.

    Kontener usuwa wizualnie ten pusty margines,
    ale zostawia pełne koło logo.
  */

  .footer-logo-crop {
    position: relative;

    width: 252px;
    height: 176px;

    overflow: hidden;

    /* podciąga całe logo bliżej kreski */
    margin-top: -14px;
  }

  .footer-logo {
    position: absolute;

    top: -12px;
    left: -43px;

    width: 230px;
    max-width: none;
    height: auto;

    display: block;
    margin: 0;

    transform: translateY(16px);
  }

  /* =========================
     PRAWA STRONA
     ========================= */

  .footer-right {
    grid-area: nav;

    display: flex;
    flex-direction: column;

    align-items: flex-end;
    justify-content: flex-start;

    gap: 8px;

    /*
      Menu zaczyna się mniej więcej
      na wysokości początku widocznego logo.
    */
    padding-top: 6px;
  }

  .footer-nav,
  .footer-meta {
    display: flex;
    flex-wrap: wrap;

    justify-content: flex-end;
    align-items: center;

    gap: 6px 15px;
  }

  .footer-nav a,
  .footer-meta a {
    color: var(--muted) !important;
    text-decoration: none !important;

    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.15;
  }

  .footer-nav a:hover,
  .footer-meta a:hover {
    color: var(--moss-dark) !important;
  }

  .footer-language {
    display: inline-flex;
    align-items: center;

    gap: 5px;

    color: var(--muted);
    font-size: 0.78rem;
  }

  /* =========================
     DOLNA LINIA
     ========================= */

  .footer-tagline,
  .footer-copyright {
    margin: 0;

    color: var(--muted);

    font-size: 0.94rem;
    font-weight: 500;
    line-height: 1.15;
  }

  .footer-tagline {
    grid-area: tagline;
    justify-self: start;
  }

  .footer-copyright {
    grid-area: copyright;

    justify-self: end;

    text-align: right;
  }

  /* =========================
     MOBILE
     ========================= */

  @media (max-width: 900px) {
    .site-footer {
      padding-bottom: 6px;
    }

    .footer-main {
      grid-template-columns: 1fr;

      grid-template-areas:
        "brand"
        "tagline"
        "nav"
        "copyright";

      row-gap: 8px;

      padding-top: 4px;
    }

    .footer-logo-crop {
      width: 196px;
      height: 140px;

      margin-top: -10px;
    }

    .footer-logo {
      top: -9px;
      left: -33px;

      width: 240px;
    }

    .footer-right {
      align-items: flex-start;

      padding-top: 0;

      gap: 6px;
    }

    .footer-nav,
    .footer-meta {
      justify-content: flex-start;

      gap: 5px 12px;
    }

    .footer-tagline,
    .footer-copyright {
      font-size: 0.9rem;
    }

    .footer-copyright {
      justify-self: start;
      text-align: left;
    }
  }

  @media (max-width: 560px) {
    .footer-logo-crop {
      width: 172px;
      height: 124px;

      margin-top: -8px;
    }

    .footer-logo {
      top: -7px;
      left: -29px;

      width: 210px;
    }
  }
</style>