---
import { testimonials } from '../content/testimonials';

interface Props {
  lang: 'en' | 'pl';
}

const { lang } = Astro.props;
const isEn = lang === 'en';
const items = testimonials[lang];

const c = isEn
  ? {
      eyebrow: 'WHAT PEOPLE SAY',
      title: 'A few words from people I have worked with',
      confidentiality:
        'To respect confidentiality, I do not publish the names of people who have shared these reflections.',
    }
  : {
      eyebrow: 'OPINIE O MNIE',
      title: 'Kilka słów od osób, z którymi pracowałam',
      confidentiality:
        'Z uwagi na zasadę poufności nie podaję imion osób, które udzieliły poniższych opinii.',
    };
---

<section class="testimonials-section" aria-labelledby={`testimonials-title-${lang}`}>
  <div class="testimonials-heading">
    <p class="eyebrow">{c.eyebrow}</p>
    <h2 id={`testimonials-title-${lang}`}>{c.title}</h2>
    <p class="testimonials-confidentiality">{c.confidentiality}</p>
  </div>

  <div class="testimonial-grid">
    {items.map((item) => (
      <blockquote class="testimonial-card">
        <p class="testimonial-quote">“{item.quote}”</p>
      </blockquote>
    ))}
  </div>
</section>

<style>
  .testimonials-section {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .testimonials-heading {
    max-width: 720px;
    margin-bottom: 22px;
  }

  .testimonials-heading h2 {
    margin-bottom: 12px;
  }

  .testimonials-confidentiality {
    margin: 0;
    color: var(--muted);
    font-size: .86rem;
    line-height: 1.55;
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
  }

  .testimonial-card {
    grid-column: span 2;
  }

  .testimonial-card:nth-child(4) {
    grid-column: 2 / span 2;
  }

  .testimonial-card:nth-child(5) {
    grid-column: 4 / span 2;
  }

  .testimonial-card {
    margin: 0;
    padding: 24px;
    border: 1px solid color-mix(in srgb, var(--moss) 34%, var(--border));
    border-radius: var(--radius);
    background: var(--moss-extra-light);
  }

  .testimonial-quote {
    margin: 0;
    line-height: 1.68;
  }

  @media (max-width: 760px) {
    .testimonial-grid {
      grid-template-columns: 1fr;
    }

    .testimonial-card,
    .testimonial-card:nth-child(4),
    .testimonial-card:nth-child(5) {
      grid-column: auto;
    }

    .testimonials-section {
      margin-top: 46px;
      padding-top: 20px;
    }
  }
</style>
