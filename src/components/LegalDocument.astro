---
interface Props {
  lang: 'pl' | 'en';
  eyebrow: string;
  title: string;
  lastUpdated: string;
}

const {
  lang,
  eyebrow,
  title,
  lastUpdated,
} = Astro.props;
---

<section class="legal-hero">
  <div class="container legal-copy">
    <p class="eyebrow">{eyebrow}</p>

    <h1><strong>{title}</strong></h1>

    <p class="legal-updated">
      {lang === 'pl' ? 'Ostatnia aktualizacja:' : 'Last updated:'}
      <strong>{lastUpdated}</strong>
    </p>
  </div>
</section>

<section class="legal-section">
  <div class="container legal-copy legal-document">
    <slot />
  </div>
</section>

<style>
  .legal-hero {
    padding: clamp(54px, 8vw, 94px) 0 clamp(36px, 5vw, 56px);
    border-bottom: 1px solid var(--border);
  }

  .legal-copy {
    max-width: 880px;
  }


  .legal-hero h1 {
    max-width: 820px;
    margin-bottom: 20px;
  }

  .legal-updated {
    margin: 0;
    color: var(--muted);
    font-size: .85rem;
  }

  .legal-updated strong {
    margin-left: .35rem;
    color: var(--text);
    font-weight: 600;
  }

  .legal-section {
    padding: clamp(40px, 6vw, 70px) 0 clamp(72px, 8vw, 110px);
  }

  .legal-document :global(.legal-intro) {
    margin-bottom: 28px;
    color: var(--muted);
    font-family: inherit;
    font-size: .97rem;
    line-height: 1.75;
  }

  .legal-document :global(.legal-section-block) {
    padding: 34px 0;
    border-top: 1px solid var(--border);
  }

  .legal-document :global(.legal-section-block:first-of-type) {
    border-top: 0;
    padding-top: 0;
  }

  .legal-document :global(h2) {
    margin-bottom: 22px;
    font-size: clamp(1.3rem, 2.4vw, 1.65rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .legal-document :global(p),
  .legal-document :global(li) {
    font-family: inherit;
    color: var(--muted);
    font-size: .97rem;
    line-height: 1.75;
  }

  .legal-document :global(p) {
    margin: 0 0 16px;
  }

  .legal-document :global(ul),
  .legal-document :global(ol) {
    margin: 12px 0 18px;
    padding-left: 1.35rem;
  }

  .legal-document :global(li + li) {
    margin-top: 8px;
  }

  .legal-document :global(.legal-details) {
    margin: 18px 0 22px;
    padding: 20px 22px;
    border-left: 3px solid var(--moss);
    background: var(--moss-extra-light);
  }

  .legal-document :global(.legal-details p) {
    margin-bottom: 4px;
    color: var(--text);
    font-family: inherit;
    font-size: .97rem;
  }

  .legal-document :global(a) {
    color: var(--brand-dark) !important;
    text-underline-offset: 3px;
  }

  .legal-document :global(strong) {
    color: var(--text);
  }

  @media (max-width: 620px) {
    .legal-document :global(.legal-section-block) {
      padding: 28px 0;
    }
  }
</style>
