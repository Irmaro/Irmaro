---
import { site } from '../config/site';
import { bookingContent } from '../content/booking';
import { bookingLinks } from '../config/bookingLinks';

interface Props {
  lang: 'en' | 'pl';
}

const { lang } = Astro.props;
const c = bookingContent[lang];

const topicByKey: Record<string, string> = {
  cv: 'cv-review',
  linkedin: 'linkedin-review',
  interview: 'interview-preparation',
};

const contactBase = lang === 'en'
  ? '/en/contact/'
  : '/pl/kontakt/';

const contactHrefFor = (key: string) => {
  const topic = topicByKey[key] ?? 'other';
  return `${contactBase}?topic=${topic}#contact-form`;
};

const directHrefFor = (key: string) => {
  if (key === 'intro') return site.booking.intro;
  if (key === 'coaching') return site.booking.session;

  if (key === 'mentoring') {
    return bookingLinks.mentoringSession || `${contactBase}?topic=mentoring-project#contact-form`;
  }

  return contactHrefFor(key);
};

const isExternalHref = (href: string) =>
  /^https?:\/\//i.test(href);

const sessionCountLabel = (count: number) => {
  if (lang === 'en') return 'sessions';
  return count === 5 ? 'sesji' : 'sesje';
};

const packageFallback = (kind: 'coaching' | 'mentoring') =>
  kind === 'coaching'
    ? `${contactBase}?topic=coaching-project#contact-form`
    : `${contactBase}?topic=mentoring-project#contact-form`;

const packageHref = (
  kind: 'coaching' | 'mentoring',
  count: number
) => {
  const links = bookingLinks.packages[kind] as Record<number, string>;
  return links[count] || packageFallback(kind);
};
---

<div class="booking-grid">
  {
    c.cards.map((card, index) => {
      const href = directHrefFor(card.key);

      return (
        <article
          class="booking-card interactive-card booking-anchor"
          id={`booking-${card.key}`}
        >
          <div>
            <p class="booking-number">{String(index + 1).padStart(2, '0')}</p>
            <p class="booking-meta">{card.meta}</p>
            <h2><strong>{card.title}</strong></h2>
            <p class="booking-copy">{card.description}</p>

            {'note' in card && card.note && (
              <p class="booking-note">{card.note}</p>
            )}
          </div>

          <a
            class="button booking-action"
            href={href}
            target={isExternalHref(href) ? '_blank' : undefined}
            rel={isExternalHref(href) ? 'noopener noreferrer' : undefined}
          >
            {card.action}
          </a>
        </article>
      );
    })
  }
</div>

<section class="package-section booking-anchor" id="booking-packages">
  <div class="package-intro green-panel">
    <p class="eyebrow">{c.packages.eyebrow}</p>
    <h2><strong>{c.packages.title}</strong></h2>
    <p>{c.packages.description}</p>
  </div>

  <div class="package-grid">
    <article
      class="package-card interactive-card"
      data-package-card
      data-kind="coaching"
    >
      <h3><strong>{c.packages.coachingLabel}</strong></h3>

      <label>
        <span>{lang === 'en' ? 'Number of sessions' : 'Liczba sesji'}</span>
        <select data-package-select>
          {c.packages.coaching.map((item) => (
            <option
              value={item.count}
              data-price={item.price}
              data-href={packageHref('coaching', item.count)}
            >
              {item.count} {sessionCountLabel(item.count)}
            </option>
          ))}
        </select>
      </label>

      <p class="package-price">
        <span data-package-price>{c.packages.coaching[0].price}</span> EUR
      </p>

      <p class="package-payment-note">{c.packages.paymentNote}</p>

      <a
        class="button"
        data-package-link
        href={packageHref('coaching', c.packages.coaching[0].count)}
      >
        {c.packages.action}
      </a>
    </article>

    <article
      class="package-card interactive-card"
      data-package-card
      data-kind="mentoring"
    >
      <h3><strong>{c.packages.mentoringLabel}</strong></h3>

      <label>
        <span>{lang === 'en' ? 'Number of sessions' : 'Liczba sesji'}</span>
        <select data-package-select>
          {c.packages.mentoring.map((item) => (
            <option
              value={item.count}
              data-price={item.price}
              data-href={packageHref('mentoring', item.count)}
            >
              {item.count} {sessionCountLabel(item.count)}
            </option>
          ))}
        </select>
      </label>

      <p class="package-price">
        <span data-package-price>{c.packages.mentoring[0].price}</span> EUR
      </p>

      <p class="package-payment-note">{c.packages.paymentNote}</p>

      <a
        class="button"
        data-package-link
        href={packageHref('mentoring', c.packages.mentoring[0].count)}
      >
        {c.packages.action}
      </a>
    </article>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('[data-package-card]').forEach((card) => {
    const select = card.querySelector('[data-package-select]');
    const price = card.querySelector('[data-package-price]');
    const link = card.querySelector('[data-package-link]');

    const updatePackage = () => {
      const option = select?.selectedOptions?.[0];

      if (price && option?.dataset.price) {
        price.textContent = option.dataset.price;
      }

      if (link && option?.dataset.href) {
        link.setAttribute('href', option.dataset.href);

        if (/^https?:\/\//i.test(option.dataset.href)) {
          link.setAttribute('target', '_blank');
          link.setAttribute('rel', 'noopener noreferrer');
        } else {
          link.removeAttribute('target');
          link.removeAttribute('rel');
        }
      }
    };

    select?.addEventListener('change', updatePackage);
    updatePackage();
  });
</script>

<style>
  .booking-anchor {
    scroll-margin-top: 96px;
  }

  .booking-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .booking-card,
  .package-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .booking-card {
    min-height: 420px;
  }

  .booking-card > div {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .booking-number {
    margin: 0 0 24px;
    color: var(--brand-dark);
    font-family: "Arial Narrow", "Aptos Narrow", sans-serif;
    font-weight: 800;
    letter-spacing: .14em;
  }

  .booking-meta {
    margin: 0 0 10px;
    color: var(--brand-dark);
    font-size: .82rem;
  }

  .booking-card h2 {
    margin-bottom: 16px;
    font-size: clamp(1.3rem, 2vw, 1.7rem);
  }

  .booking-copy {
    margin: 0;
    color: var(--muted);
  }

  .booking-note {
    margin-top: auto;
    padding-top: 16px;
    color: var(--moss-dark);
    font-size: .8rem;
    font-weight: 650;
  }

  .booking-action {
    margin-top: 16px;
    align-self: flex-start;
  }

  .package-section {
    margin-top: 48px;
  }

  .package-intro {
    width: 100%;
    max-width: none;
    margin-bottom: 16px;
  }

  .package-intro p:last-child {
    margin-bottom: 0;
  }

  .package-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .package-card {
    gap: 16px;
  }

  .package-card label {
    display: grid;
    gap: 8px;
    color: var(--muted);
    font-size: .85rem;
  }

  .package-card select {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
  }

  /* Smaller and less aggressive than before */
  .package-price {
    margin: 0;
    color: var(--moss-dark);
    font-family: inherit;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .package-payment-note {
    margin: -4px 0 2px;
    color: var(--moss-dark);
    font-size: .8rem;
    line-height: 1.45;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .booking-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 700px) {
    .booking-grid,
    .package-grid {
      grid-template-columns: 1fr;
    }

    .booking-card {
      min-height: 0;
    }
  }
</style>
