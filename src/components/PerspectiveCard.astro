---
interface Props {
  number?: string;
  title: string;
  lead: string;
  href: string;
  image: string;
  imageAlt: string;
  lang: 'pl' | 'en';
}

const { title, lead, href, image, imageAlt, lang } = Astro.props;
const readMore = lang === 'pl' ? 'Czytaj dalej' : 'Read more';
---

<article class="perspective-card">
  <a class="perspective-image-link" href={href} aria-label={`${readMore}: ${title}`}>
    <img
      class="perspective-image"
      src={image}
      alt={imageAlt}
      loading="lazy"
      decoding="async"
    />
  </a>

  <div class="perspective-content">
    <div>
      <h2><a href={href}>{title}</a></h2>
      <p class="perspective-lead">{lead}</p>
    </div>

    <a class="perspective-link" href={href}>
      {readMore} <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .perspective-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    transition:
      background-color .18s ease,
      border-color .18s ease,
      transform .18s ease;
  }

  .perspective-card:hover {
    border-color: var(--moss);
    background: color-mix(in srgb, var(--moss-extra-light) 28%, var(--bg));
    transform: translateY(-2px);
  }

  .perspective-image-link {
    display: block;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .perspective-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform .25s ease;
  }

  .perspective-card:hover .perspective-image {
    transform: scale(1.015);
  }

  .perspective-content {
    display: flex;
    min-height: 250px;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
  }

  .perspective-card h2 {
    margin-bottom: 12px;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    font-weight: 700;
  }

  .perspective-card h2 a {
    color: var(--text) !important;
    text-decoration: none;
  }

  .perspective-lead {
    margin: 0;
    color: var(--muted);
    font-size: .9rem;
    line-height: 1.62;
  }

  .perspective-link {
    margin-top: 20px;
    color: var(--moss-dark) !important;
    font-weight: 800;
    text-decoration: none;
    font-size: .9rem;
  }

  .perspective-link span {
    color: var(--brand-dark);
  }

  @media (max-width: 760px) {
    .perspective-content {
      min-height: 0;
    }
  }
</style>
